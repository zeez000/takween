{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takween-labs-preview",
  "account_id": "86401cad0432f54a806404883ec7b39f",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "takween-labs-preview" }],
  "workers_dev": true,
  "ratelimits": [
    {"name":"ENQUIRY_IP_LIMITER","namespace_id":"31001","simple":{"limit":5,"period":60}},
    {"name":"ENQUIRY_SITE_LIMITER","namespace_id":"31002","simple":{"limit":30,"period":60}}
  ],
  "vars": {
    "ENQUIRY_ENABLED": "false",
    "PERSISTENT_ENQUIRIES_ENABLED": "false",
    "OPERATIONS_ENABLED": "false",
    "BUSINESS_OPERATIONS_ENABLED": "false",
    "ENQUIRY_NOTIFICATIONS_ENABLED": "false",
    "SITE_URL": "https://takween-labs-preview.abdzeez000.workers.dev",
    "SITE_INDEXING_ENABLED": "false"
  },
  "observability": { "enabled": false }
}
