# Public project configuration only. Actual values belong in ignored .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never place secret/service-role keys in NEXT_PUBLIC_ variables.

# Optional build-time SEO settings. Leave indexing off for private/pre-launch previews.
# SITE_URL must be the actual approved public HTTPS origin, not a guessed hostname.
SITE_URL=
SITE_INDEXING_ENABLED=false
# Server-only email configuration. Never use NEXT_PUBLIC_ for these values.
ENQUIRY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Operational preparation: all activation remains owner-approved and off by default.
PERSISTENT_ENQUIRIES_ENABLED=false
OPERATIONS_ENABLED=false
BUSINESS_OPERATIONS_ENABLED=false
# Must match an owner-approved privacy notice; no default policy is assumed.
ENQUIRY_PRIVACY_VERSION=
# Server-only Worker bindings for future persistent intake, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Owner-approved notice text displayed only when persistent intake is activated.
ENQUIRY_PRIVACY_NOTICE=
# Separate approval gate: no real notification sending in local preparation.
ENQUIRY_NOTIFICATIONS_ENABLED=false
# Optional single request origin for isolated localhost Worker tests. In deployed
# environments leave empty to use SITE_URL; never use wildcard origins.
REQUEST_ORIGIN=
