# Public project configuration only. Actual values belong in ignored .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never place secret/service-role keys in NEXT_PUBLIC_ variables.

# Optional build-time SEO settings. Leave indexing off for private/pre-launch previews.
# SITE_URL must be the actual approved public HTTPS origin, not a guessed hostname.
SITE_URL=
SITE_INDEXING_ENABLED=false
